<?xml version="1.0" encoding="utf-8"?>
<!-- 本地虚拟 WAV（127.0.0.1）和用户显式填写的 VoiceStudio 局域网地址都可能走
     http。除此之外 App 不发起明文请求，云端 Edge 仍走 HTTPS。
     只把 VoiceStudio 暴露在可信局域网，不要直接开到公网。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
